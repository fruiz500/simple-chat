rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/zoom-clone/public/data/zoom_rooms/{room} {
      // A room can be opened by its exact (hashed) id, but rooms cannot be listed.
      allow get, create, update: if request.auth != null;

      match /participants/{p} {
        allow read, write: if request.auth != null;
      }
      match /connections/{c} {
        allow read, write: if request.auth != null;
        match /callerCandidates/{x} { allow read, write: if request.auth != null; }
        match /calleeCandidates/{x} { allow read, write: if request.auth != null; }
      }
      match /chat/{m} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
      }
    }
    // Everything else is closed.
  }
}
